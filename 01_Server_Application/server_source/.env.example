# Copy to .env or export these variables before starting a process.
# SynCanvas never requires an internet connection.

# --- Server ---
SYNCANVAS_HOST=0.0.0.0
SYNCANVAS_PORT=45871
SYNCANVAS_DB=database/syncanvas.db
SYNCANVAS_DATA_DIR=
SYNCANVAS_AUTOSAVE=2.0
SYNCANVAS_SNAPSHOT_INTERVAL=300
SYNCANVAS_MAX_SESSIONS=50
SYNCANVAS_MAX_CLIENTS=40
SYNCANVAS_REQUIRE_PASSWORD=false
SYNCANVAS_MOTD=Welcome to SynCanvas
SYNCANVAS_LOG_LEVEL=INFO

# --- Client ---
SYNCANVAS_CLIENT_CONFIG=
SYNCANVAS_EXPORT_DIR=
